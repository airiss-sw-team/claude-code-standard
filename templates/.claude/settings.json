{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "팀 공유 baseline. 비밀과 위험권한 금지. 스택별 allow 추가 예시는 ADOPTION.md 참조.",
  "//_windows": "Bash 와 PowerShell 을 반드시 병기할 것. 네이티브 Windows에서 Git for Windows가 없으면 Bash 도구 자체가 없고 PowerShell 도구가 쓰인다 → Bash(...) 규칙이 하나도 매칭되지 않는다.",
  "//_deny": "deny와 ask 는 레포에서 추가만 가능(완화는 표준 레포 PR). deny/ask 는 폴더 신뢰 전에도 즉시 적용되지만, allow 는 workspace trust 수락 후에만 적용된다. 같은 명령이 allow 와 ask 에 다 걸리면 ask 가 이긴다.",
  "//_ask": "작업 중인 변경이나 이력을 지우는 git 명령은 ask. git restore 와 git checkout -- 는 저장 안 한 수정을 되돌릴 수 없게 버린다.",
  "permissions": {
    "allow": [
      "Bash(git status)", "PowerShell(git status)",
      "Bash(git diff:*)", "PowerShell(git diff *)",
      "Bash(git log:*)", "PowerShell(git log *)",
      "Bash(git branch:*)", "PowerShell(git branch *)",
      "Bash(git add:*)", "PowerShell(git add *)"
    ],
    "ask": [
      "Bash(git push:*)", "PowerShell(git push *)",
      "Bash(git add -A:*)", "PowerShell(git add -A *)",
      "Bash(git add .:*)", "PowerShell(git add . *)",
      "Bash(git restore:*)", "PowerShell(git restore *)",
      "Bash(git checkout --:*)", "PowerShell(git checkout -- *)",
      "Bash(git reset --hard:*)", "PowerShell(git reset --hard *)",
      "Bash(git clean:*)", "PowerShell(git clean *)",
      "Bash(git rebase:*)", "PowerShell(git rebase *)",
      "Bash(git branch -D:*)", "PowerShell(git branch -D *)",
      "Bash(git stash drop:*)", "PowerShell(git stash drop *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/.credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/appsettings.Production.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/.credentials.json)",
      "Edit(**/secrets.json)",
      "Edit(**/appsettings.Production.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
